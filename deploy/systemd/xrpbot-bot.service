# /etc/systemd/system/xrpbot-bot.service  (ajusta User y rutas)
[Unit]
Description=xrpbot - bot de trading PF_XRPUSD
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=xrpbot
WorkingDirectory=/opt/xrpbot
# Empieza en SIM. Modo real (tras el plan de pruebas): --mode live --live y
# XRPBOT_LIVE_CONFIRM en /opt/xrpbot/.env. Cambia también el modo del watchdog y de la interfaz.
ExecStart=/opt/xrpbot/.venv/bin/python -m xrpbot.cli run --mode sim
Restart=always
RestartSec=30
# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xrpbot/state /opt/xrpbot/logs /opt/xrpbot/data

[Install]
WantedBy=multi-user.target
