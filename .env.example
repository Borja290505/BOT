# Copia este fichero a .env y rellénalo. NUNCA subas .env al repositorio.
# Claves SEPARADAS para demo y real. Permisos mínimos: consulta + trading.
# NUNCA actives el permiso de retirada. Restringe las claves por IP en Kraken.

# Entorno demo (https://demo-futures.kraken.com, claves creadas allí)
KRAKEN_DEMO_API_KEY=
KRAKEN_DEMO_API_SECRET=

# Entorno real (solo se leen en modo live)
KRAKEN_LIVE_API_KEY=
KRAKEN_LIVE_API_SECRET=

# Alertas de Telegram (recomendado: es el canal de respaldo del watchdog y de la PWA)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watchdog: minutos sin latido antes de avisar, y cada cuánto recordar mientras dure
WATCHDOG_MAX_SILENCE_MIN=5
WATCHDOG_REMIND_MIN=30
# Opcional: URL de ping de un servicio externo (p. ej. healthchecks.io) que avise si
# deja de recibir pings = se ha caído el servidor entero (bot y watchdog a la vez)
WATCHDOG_PING_URL=

# Solo para modo live SIN terminal (Docker/systemd). Confirmación explícita:
# XRPBOT_LIVE_CONFIRM=OPERAR EN REAL PF_XRPUSD
